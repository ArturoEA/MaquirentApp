rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. Fotos del equipo
    match /fotos_equipo/{grupoId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // 2. Planos de cambio de voltaje
    match /planos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // 3. Fotos de placa de especificaciones
    match /placas/{carpeta}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // 4. Fotos de maquinaria / grupos electrógenos
    match /grupos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // 5. Fotos de mantenimiento
    match /mantenimientos/{codigoGrupo}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // 6. Fichas técnicas en PDF
    match /fichas_tecnicas/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // 7. Accesorios e íconos de accesorios
    match /accesorios/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // 8. Íconos de tipos de mantenimiento
    match /mantenimientos_configuracion/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // 9. Perfil y firma digital de usuarios
    match /perfiles/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /firmas/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // 10. Actualizaciones de la app (APKs)
    match /updates/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 11. Regla global para cualquier otro recurso de la app
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
