        <action
            android:id="@+id/action_homeFragment_to_nuevoAlquilerMensualFragment"
            app:destination="@id/nuevoAlquilerMensualFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
