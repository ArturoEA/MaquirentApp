        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right" />
        <argument
            android:name="idGrupo"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/nuevoAlquilerDiaFragment"
        android:name="com.example.maquirentapp.View.NuevoAlquilerDiaFragment"
        android:label="Alquiler Diario"
        tools:layout="@layout/fragment_nuevo_alquiler_dia">
        <argument
            android:name="idGrupo"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="alquilerId"
            app:argType="string"
            app:nullable="true" />
    </fragment>

