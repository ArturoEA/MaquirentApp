        tools:layout="@layout/fragment_nuevo_alquiler_mensual">

    </fragment>

    <fragment
        android:id="@+id/historialAlquilerDiarioFragment"
        android:name="com.example.maquirentapp.View.HistorialAlquilerDiarioFragment"
        android:label="Historial Alquileres Diarios"
        tools:layout="@layout/fragment_historial_alquiler_mensual"> <action
        android:id="@+id/action_historialAlquilerDiario_to_nuevoAlquilerDia"
