        android:name="com.example.maquirentapp.View.AuthFragment"
        android:label="Autenticación"
        tools:layout="@layout/fragment_auth">
        <action
            android:id="@+id/action_auth_to_home"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_auth_to_tareas"
            app:destination="@id/tareasFragment" />
    </fragment>

    <fragment
