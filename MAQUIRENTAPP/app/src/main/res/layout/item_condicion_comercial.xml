<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:theme="@style/Theme.TextMain"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <CheckBox
            android:id="@+id/cbCondicion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            app:buttonTint="@color/azul_100" />

        <TextView
            android:id="@+id/tvCondicion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/anta_font"
            android:text="Condición comercial de ejemplo para el contrato."
            android:textColor="@color/black"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/btnEditarCondicion"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Editar"
            android:padding="5dp"
            android:src="@drawable/ic_pencil_edit" />

        <ImageView
            android:id="@+id/btnEliminarCondicion"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar"
            android:padding="5dp"
            android:src="@drawable/icon_eliminar_rojo" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
