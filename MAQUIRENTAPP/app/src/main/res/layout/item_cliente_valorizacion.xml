<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:theme="@style/Theme.TextMain"
    app:cardCornerRadius="12dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/icon_perfil_blanco"
            app:tint="@color/black"
            android:layout_marginEnd="16dp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minera Yanacocha S.R.L."
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvRucEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RUC: 20601234567"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_flecha_negro"
            android:rotation="180"/> </LinearLayout>
</androidx.cardview.widget.CardView>