<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:theme="@style/Theme.TextMain"
    android:background="@color/black"
    android:backgroundTint="@color/black"
    app:cardBackgroundColor="@color/black"
    app:cardCornerRadius="12dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minera Yanacocha S.R.L."
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvRucEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="RUC: 20601234567"
                android:textColor="#CCCCCC"
                android:textSize="14sp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/btnEliminarCliente"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar cliente"
            android:padding="7dp"
            android:src="@drawable/icon_eliminar_rojo"
            app:tint="@color/red_accent" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_flecha_negro"
            app:tint="@color/white"
            android:rotation="180"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
