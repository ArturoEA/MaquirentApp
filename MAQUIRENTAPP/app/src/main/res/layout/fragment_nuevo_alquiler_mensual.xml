<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".View.NuevoAlquilerMensualFragment"
    android:theme="@style/Theme.TextMain">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/CustomTextInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputEmpresa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:hint="Empresa que alquila el equipo" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/CustomTextInputLayout"
                android:layout_marginEnd="20dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="Horómetro inicial">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputHorometroInicial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:hint="Horómetro inicial"
                    android:textColor="@color/black"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/CustomTextInputLayout"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="Fecha inicial">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputFechaInicial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="Fecha inicial"
                    android:textColor="@color/black"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/CustomTextInputLayout"
            android:hint="Lugar de trabajo del equipo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Lugar de trabajo del equipo"
                android:textColor="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/CustomTextInputLayout"
                android:layout_marginEnd="20dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="Horómetro final">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputHorometroFinal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Horómetro final"
                    android:inputType="numberDecimal"
                    android:textColor="@color/black"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/CustomTextInputLayout"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="Fecha final">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputFechaFinal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="Fecha final"
                    android:textColor="@color/black"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/CustomTextInputLayout"
                android:layout_marginEnd="7dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="Precio de alquiler">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputPrecioAlquiler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Precio de alquiler"
                    android:inputType="numberDecimal"
                    android:textColor="@color/black"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/CustomTextInputLayout"
                android:layout_width="0dp"
                android:layout_weight="1">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputHorasMinimas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Horas mínimas"
                    android:inputType="number"
                    android:textColor="@color/black"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/CustomTextInputLayout"
            android:hint="Precio por hora extra">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPrecioHoraExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Precio por hora extra"
                android:inputType="numberDecimal"
                android:textColor="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Título de accesorios -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="Selecciona los accesorios incluidos"/>

        <!-- RecyclerView de accesorios -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAccesorios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="80dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>