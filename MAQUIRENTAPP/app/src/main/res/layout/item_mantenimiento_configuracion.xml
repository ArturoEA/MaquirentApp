<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    android:backgroundTint="@color/black"
    android:foreground="?android:attr/selectableItemBackground"
    android:theme="@style/Theme.TextMain">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreMantenimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cambio de aceite de motor y filtro"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalleIntervalo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Cada 250 h (o máx. 6 meses)"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btnEditarMantenimiento"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="7dp"
            android:src="@drawable/icon_editar_blanco"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Editar mantenimiento" />

        <ImageView
            android:id="@+id/btnEliminarMantenimiento"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="7dp"
            android:src="@drawable/icon_eliminar_rojo"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar mantenimiento" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
