<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:theme="@style/Theme.TextMain"
    app:cardCornerRadius="15dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Contenedor para la vista previa del PDF -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@android:color/white">

            <!-- Imagen de vista previa -->
            <ImageView
                android:id="@+id/iv_pdf_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/white"
                android:scaleType="centerCrop" />

            <!-- Icono de PDF por defecto -->
            <ImageView
                android:id="@+id/iv_pdf_icon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                app:tint="@android:color/holo_red_dark" />

            <!-- ProgressBar mientras carga -->
            <ProgressBar
                android:id="@+id/progress_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/black"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Fila Nombre del archivo y Botón Editar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Nombre del archivo -->
            <TextView
                android:id="@+id/tv_nombre_archivo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/anta_font"
                android:maxLines="2"
                android:text="ficha_tecnica.pdf"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Botón editar nombre del PDF -->
            <ImageButton
                android:id="@+id/btn_editar_nombre"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/icon_editar_blanco"
                android:backgroundTint="@color/white"
                android:contentDescription="Editar nombre" />

        </LinearLayout>

        <!-- Botones de acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Botón compartir -->
            <ImageButton
                android:id="@+id/btn_compartir"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/icon_compartir"
                android:backgroundTint="@color/white"
                android:contentDescription="Compartir" />

            <!-- Botón descargar -->
            <ImageButton
                android:id="@+id/btn_descargar"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/icon_descargar"
                android:backgroundTint="@color/white"
                android:contentDescription="Descargar" />

            <!-- Botón eliminar -->
            <ImageButton
                android:id="@+id/btn_eliminar"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/icon_eliminar_negro"
                android:backgroundTint="@color/white"
                android:contentDescription="Eliminar" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>