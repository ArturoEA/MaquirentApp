<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDetalleMes"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:backgroundTint="@android:color/transparent"
    android:theme="@style/Theme.TextMain"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/franjaColor"
            android:layout_width="15dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:background="@color/red_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/black"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tvTituloPeriodo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Agosto - Setiembre"
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/btnExpandir"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_flecha_abajo"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutContenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">


                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputHorometro"
                    style="@style/DetalleMesTextInputLayout"
                    android:hint="Horómetro al 25/09/2025">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputHorometro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:imeOptions="actionDone"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/DetalleMesTextInputLayout"
                        android:layout_width="0dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="0.8"
                        android:hint="Horas extras">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputHorasExtras"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="136"
                            android:textColor="@color/white" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/DetalleMesTextInputLayout"
                        android:layout_width="0dp"
                        android:layout_weight="1.2"
                        android:hint="Precio de HE">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPrecioHE"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:text="S/. 1940.04"
                            android:textColor="@color/white" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnConfirmarPagoMes"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/selection_indicator"
                    android:text="Confirmar pago de mes"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/tvConfirmacionPagoMes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:layout_marginBottom="5dp"
                    android:textColor="@color/white"
                    android:text="Pago realizado el 25/12/2025"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnConfirmarPagoHE"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/selection_indicator"
                    android:text="Confirmar pago de HE"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/tvConfirmacionPagoHE"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:layout_marginBottom="5dp"
                    android:textColor="@color/white"
                    android:text="Pago realizado el 25/12/2025"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnValorizacion"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/selection_indicator"
                    android:text="Valorización"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
