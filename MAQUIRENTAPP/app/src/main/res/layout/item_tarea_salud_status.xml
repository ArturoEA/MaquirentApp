<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:backgroundTint="#24292E"
    android:theme="@style/Theme.TextMain"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Fila 1: Nombre de la actividad y estado corto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNombreTareaSalud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/anta_font"
                android:maxLines="2"
                android:text="Cambio de aceite de motor"
                android:textColor="@color/white"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBadgeEstadoTarea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/dialog_rounded_white_background"
                android:fontFamily="@font/anta_font"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:text="Al día"
                android:textColor="@color/white"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fila 2: Resumen corto (frecuencia · último · uso) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFrecuenciaTarea"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/anta_font"
                android:singleLine="true"
                android:text="Cada 250 h · Último: 1,500 h"
                android:textColor="#90A4AE"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvHorasAcumuladasDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/anta_font"
                android:text="180 / 250 h"
                android:textColor="#CFD8DC"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Barra delgada y sutil de desgaste -->
        <ProgressBar
            android:id="@+id/pbDesgasteTarea"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/bg_progress_salud" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
