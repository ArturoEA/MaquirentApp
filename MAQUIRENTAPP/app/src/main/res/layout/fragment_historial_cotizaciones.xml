<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:theme="@style/Theme.TextMain"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnAnterior"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:background="@drawable/icon_flecha_negro"/>

        <TextView
            android:id="@+id/tvAnio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:text="2025"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSiguiente"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:background="@drawable/icon_flecha_negro"
            android:rotation="180"/>
    </LinearLayout>

    <include
        android:id="@+id/shimmerCotizaciones"
        layout="@layout/skeleton_list_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCotizaciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        tools:listitem="@layout/item_historial_cotizacion" />

    <LinearLayout
        android:id="@+id/emptyStateCotizaciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/icon_cotizacion_blanco"
            app:tint="@color/gray_dark"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No hay cotizaciones este año"
            android:textColor="@color/gray_dark"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutPaginacionCotizaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="70dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnPaginaAnterior"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:background="@drawable/icon_flecha_negro"
            android:contentDescription="Página anterior" />

        <TextView
            android:id="@+id/tvInfoPaginacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:fontFamily="@font/anta_font"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Página 1 de 3" />

        <ImageButton
            android:id="@+id/btnPaginaSiguiente"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:background="@drawable/icon_flecha_negro"
            android:rotation="180"
            android:contentDescription="Página siguiente" />
    </LinearLayout>

</LinearLayout>