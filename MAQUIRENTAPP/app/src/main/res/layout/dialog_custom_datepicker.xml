<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_custom_datepicker_dialog"
    android:orientation="vertical"
    android:padding="20dp"
    android:theme="@style/Theme.TextMain">

    <!-- Header: Mes/Año y Chevrons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvMesAnio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/anta_font"
            android:text="ENERO 2025"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnMesAnterior"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Mes anterior"
            android:padding="4dp"
            android:src="@drawable/ic_chevron_left_white"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btnMesSiguiente"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Mes siguiente"
            android:padding="4dp"
            android:src="@drawable/ic_chevron_right_white"
            app:tint="@color/white" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="12dp"
        android:background="#2C2C2C" />

    <!-- Días de la semana (LUN - DOM) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/anta_font"
            android:gravity="center"
            android:text="LUN"
            android:textColor="#A0A0A0"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/anta_font"
            android:gravity="center"
            android:text="MAR"
            android:textColor="#A0A0A0"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/anta_font"
            android:gravity="center"
            android:text="MIE"
            android:textColor="#A0A0A0"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/anta_font"
            android:gravity="center"
            android:text="JUE"
            android:textColor="#A0A0A0"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/anta_font"
            android:gravity="center"
            android:text="VIE"
            android:textColor="#A0A0A0"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/anta_font"
            android:gravity="center"
            android:text="SAB"
            android:textColor="#A0A0A0"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/anta_font"
            android:gravity="center"
            android:text="DOM"
            android:textColor="#A0A0A0"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Grid de días del mes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDiasCalendario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />

    <!-- Botones CANCEL y OK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDatePickerCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/anta_font"
            android:text="CANCEL"
            android:textColor="#A0A0A0"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnDatePickerOk"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:fontFamily="@font/anta_font"
            android:text="OK"
            android:textColor="@color/azul_100"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
