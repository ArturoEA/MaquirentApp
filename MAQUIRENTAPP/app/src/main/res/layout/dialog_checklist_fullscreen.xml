<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical"
    android:theme="@style/Theme.TextMain">

    <!-- Toolbar con tipografía Anta -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarChecklist"
        style="@style/Widget.MaterialComponents.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_dark"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:navigationIcon="@drawable/ic_arrow_back_white"
        app:title="Pendientes"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        app:titleTextColor="@color/white" />

    <!-- Resumen de la máquina -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#263238"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvChecklistTipoEquipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/anta_font"
                    android:text="Grupo electrógeno"
                    android:textColor="#90CAF9"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvChecklistSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/anta_font"
                    android:text="Actividades vencidas y próximas"
                    android:textColor="#CFD8DC"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvChecklistHorometro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_anio_selected"
                android:fontFamily="@font/anta_font"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="-"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Lista de actividades pendientes -->
    <ScrollView
        android:id="@+id/scrollChecklist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/llChecklistContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Botón de acción coherente con la app -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuardarChecklist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="@color/selection_indicator"
        android:fontFamily="@font/anta_font"
        android:paddingVertical="12dp"
        android:text="Registrar mantenimiento"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:cornerRadius="12dp" />

</LinearLayout>
