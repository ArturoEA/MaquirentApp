<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="2dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:theme="@style/Theme.TextMain"
    android:background="@color/black"
    android:backgroundTint="@color/black"
    app:cardBackgroundColor="@color/black"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila Superior: Código y Fecha Emisión -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNumeroVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bottom_nav_rounded"
                android:backgroundTint="@color/azul_100"
                android:fontFamily="@font/anta_font"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="VAL-000105"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvFechaEmision"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/anta_font"
                android:text="24/10/2026"
                android:textColor="#BBBBBB"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Nombre del Cliente -->
        <TextView
            android:id="@+id/tvCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/anta_font"
            android:maxLines="1"
            android:text="Minera Yanacocha S.R.L."
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Equipo y Obra -->
        <TextView
            android:id="@+id/tvEquipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/anta_font"
            android:maxLines="2"
            android:text="Grupo Electrógeno 110kW • G-01"
            android:textColor="#CCCCCC"
            android:textSize="13sp" />

        <!-- Período de Tareo -->
        <TextView
            android:id="@+id/tvPeriodoTareo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/anta_font"
            android:text="Periodo: 01/10/2026 al 31/10/2026 (30 días)"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <!-- Fila Inferior: Badge HE / Monto Total / Flecha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBadgeHE"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/anta_font"
                android:text="Con Horas Extras"
                android:textColor="@color/yellow_accent"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/anta_font"
                android:text="S/. 15,000.00"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Abrir PDF"
                android:rotation="180"
                android:src="@drawable/icon_flecha_negro"
                app:tint="@color/white" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
