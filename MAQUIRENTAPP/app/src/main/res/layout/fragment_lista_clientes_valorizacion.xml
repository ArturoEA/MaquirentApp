<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="@style/Theme.TextMain"
    tools:context=".View.ListaClientesValorizacionFragment">

    <!-- Selector de Pestañas: Por Clientes vs Consolidado -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleVistaValorizaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:checkedButton="@id/btnTabClientes"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabClientes"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:fontFamily="@font/anta_font"
            android:text="Por Clientes"
            android:textColor="@color/selector_toggle_text"
            android:textSize="13sp"
            app:backgroundTint="@color/selector_toggle_bg"
            app:strokeColor="@color/black" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabConsolidado"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:fontFamily="@font/anta_font"
            android:text="Consolidado"
            android:textColor="@color/selector_toggle_text"
            android:textSize="13sp"
            app:backgroundTint="@color/selector_toggle_bg"
            app:strokeColor="@color/black" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- ============================================== -->
    <!-- VISTA 1: POR CLIENTES (COMPORTAMIENTO ORIGINAL) -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/layoutVistaClientes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnAnterior"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:background="@drawable/icon_flecha_negro"
                android:contentDescription="Año anterior" />

            <TextView
                android:id="@+id/tvAnio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:fontFamily="@font/anta_font"
                android:text="2026"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSiguiente"
                android:layout_width="40dp"
                android:layout_height="30dp"
                android:background="@drawable/icon_flecha_negro"
                android:contentDescription="Año siguiente"
                android:rotation="180" />
        </LinearLayout>

        <include
            android:id="@+id/shimmerClientes"
            layout="@layout/skeleton_list_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerClientesValorizaciones"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="80dp"
            tools:listitem="@layout/item_cliente_valorizacion" />
    </LinearLayout>

    <!-- ============================================== -->
    <!-- VISTA 2: CONSOLIDADO MENSUAL / EJECUTIVO       -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/layoutVistaConsolidado"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Barra de navegación de período / mes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnMesAnterior"
                android:layout_width="36dp"
                android:layout_height="30dp"
                android:background="@drawable/icon_flecha_negro"
                android:contentDescription="Mes anterior" />

            <TextView
                android:id="@+id/tvPeriodoConsolidado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/anta_font"
                android:gravity="center"
                android:text="Octubre 2026"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMesSiguiente"
                android:layout_width="36dp"
                android:layout_height="30dp"
                android:background="@drawable/icon_flecha_negro"
                android:contentDescription="Mes siguiente"
                android:rotation="180" />

            <ImageButton
                android:id="@+id/btnFiltrarRango"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Filtrar por rango"
                android:padding="6dp"
                android:src="@drawable/ic_calendar_range"
                app:tint="@color/black" />
        </LinearLayout>

        <!-- Indicador de rango personalizado activo -->
        <LinearLayout
            android:id="@+id/layoutChipRangoActivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTextoRangoActivo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/anta_font"
                android:text="Rango: 01/10/2026 al 24/10/2026"
                android:textColor="@color/azul_100"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnLimpiarRango"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/anta_font"
                android:padding="4dp"
                android:text="✕ Quitar filtro"
                android:textColor="@color/red_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tarjetas de resumen ejecutivo de totales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <!-- Card Total Soles -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/anta_font"
                        android:text="Total Soles"
                        android:textColor="#CCCCCC"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTotalConsolidadoSoles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/anta_font"
                        android:text="S/. 0.00"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Total Dólares -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/black"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/anta_font"
                        android:text="Total Dólares"
                        android:textColor="#CCCCCC"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTotalConsolidadoDolares"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/anta_font"
                        android:text="$ 0.00"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Fila de información y botón Exportar Excel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvCantidadValorizaciones"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/anta_font"
                android:text="0 valorizaciones emitidas"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnExportarExcel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:fontFamily="@font/anta_font"
                android:text="Exportar Excel"
                android:textColor="@color/azul_100"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Shimmer Consolidado -->
        <include
            android:id="@+id/shimmerConsolidado"
            layout="@layout/skeleton_list_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Empty State Consolidado -->
        <TextView
            android:id="@+id/emptyStateConsolidado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/anta_font"
            android:gravity="center"
            android:padding="32dp"
            android:text="No se encontraron valorizaciones emitidas en este período."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Lista de Valorizaciones Consolidadas -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerConsolidadoValorizaciones"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="80dp"
            tools:listitem="@layout/item_consolidado_valorizacion" />

    </LinearLayout>

</LinearLayout>
