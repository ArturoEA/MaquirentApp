<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_white_background"
    android:orientation="vertical"
    android:theme="@style/Theme.TextMain"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTituloDialogoTarea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Detalle de Tarea"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Sección de Checklist SOP -->
    <LinearLayout
        android:id="@+id/layoutChecklistContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Procedimiento Técnico (Checklist SOP):"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:id="@+id/layoutChecklistItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSubtituloResponsables"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Seleccione responsables:"
        android:textColor="@color/text_secondary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerParticipantes"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCompletarTarea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/selection_indicator"
        android:text="Marcar como completada"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/btnAprobarGerencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#2E7D32"
        android:text="✓ Dar V°B° / Aprobar por Gerencia"
        android:textColor="@color/white"
        android:visibility="gone" />

</LinearLayout>