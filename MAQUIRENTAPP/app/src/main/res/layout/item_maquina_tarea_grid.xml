<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardMaquinaTarea"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:backgroundTint="@color/background_dark"
    android:foreground="?android:attr/selectableItemBackground"
    android:theme="@style/Theme.TextMain"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Fila Superior: Código del equipo y Badge de Estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCodigoMaquinaGrid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/anta_font"
                android:singleLine="true"
                android:text="GEP-100"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBadgeEstadoGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/dialog_rounded_white_background"
                android:fontFamily="@font/anta_font"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:text="Al día"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtítulo: Tipo/Potencia y Horómetro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSubtituloMaquinaGrid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/anta_font"
                android:singleLine="true"
                android:text="Grupo electrógeno"
                android:textColor="#90CAF9"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvHorometroMaquinaGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/anta_font"
                android:text="1,750.0 h"
                android:textColor="#CFD8DC"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#37474F" />

        <!-- Etiqueta Vistazo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/anta_font"
            android:text="TAREAS PENDIENTES"
            android:textColor="#78909C"
            android:textSize="9sp"
            android:textStyle="bold" />

        <!-- Contenedor Vistazo -->
        <LinearLayout
            android:id="@+id/layoutVistazoTareasGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVistazoItem1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/anta_font"
                android:singleLine="true"
                android:text="• Cambio de aceite (+15 h)"
                android:textColor="#EF9A9A"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvVistazoItem2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/anta_font"
                android:singleLine="true"
                android:text="• Filtro de combustible"
                android:textColor="#FFF59D"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvMasTareasGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/anta_font"
                android:text="+ 2 tareas más"
                android:textColor="#90CAF9"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSinTareasGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/anta_font"
                android:text="Al día (0 pendientes)"
                android:textColor="#81C784"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Barra inferior: Ver checklist -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_anio_unselected"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/anta_font"
                android:text="Ver checklist"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
