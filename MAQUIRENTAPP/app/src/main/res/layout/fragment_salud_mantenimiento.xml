<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:theme="@style/Theme.TextMain">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Shimmer de carga -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerSalud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginBottom="16dp"
                    android:background="#333333" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginBottom="16dp"
                    android:background="#333333" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="#333333" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Contenedor Principal de Datos -->
        <LinearLayout
            android:id="@+id/layoutContenidoSalud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========================================================= -->
            <!-- 1. HERO CARD: ESTADO GENERAL Y HORÓMETRO                 -->
            <!-- ========================================================= -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/background_dark"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTituloEquipoSalud"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/anta_font"
                            android:text="Estado Operativo General"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBadgeGeneralSalud"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/dialog_rounded_white_background"
                            android:fontFamily="@font/anta_font"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:text="Operativo"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/anta_font"
                                android:text="HORÓMETRO ACTUAL"
                                android:textColor="#B0BEC5"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvHorometroActualGrande"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/anta_font"
                                android:text="1,750.0 h"
                                android:textColor="@color/white"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/anta_font"
                                android:text="ÍNDICE DE SALUD"
                                android:textColor="#B0BEC5"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvIndiceSaludPorcentaje"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/anta_font"
                                android:text="92%"
                                android:textColor="#4CAF50"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Contador de Tareas en 3 Bloques -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/btnFiltroAlDiaBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/dialog_rounded_white_background"
                            android:backgroundTint="#1B5E20"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/tvTotalAlDia"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/anta_font"
                                android:text="24"
                                android:textColor="#81C784"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/anta_font"
                                android:text="Al día"
                                android:textColor="#E8F5E9"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnFiltroProximasBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/dialog_rounded_white_background"
                            android:backgroundTint="#F57F17"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/tvTotalProximas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/anta_font"
                                android:text="3"
                                android:textColor="#FFF59D"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/anta_font"
                                android:text="Próximas"
                                android:textColor="#FFFDE7"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnFiltroVencidasBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/dialog_rounded_white_background"
                            android:backgroundTint="#B71C1C"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/tvTotalVencidas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/anta_font"
                                android:text="1"
                                android:textColor="#EF9A9A"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/anta_font"
                                android:text="Vencidas"
                                android:textColor="#FFEBEE"
                                android:textSize="11sp" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ========================================================= -->
            <!-- 2. DISCIPLINA Y PUNTUALIDAD                              -->
            <!-- ========================================================= -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/background_dark"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/anta_font"
                        android:text="Disciplina de Mantenimiento"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvValorPuntualidad"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/anta_font"
                                android:text="85.7%"
                                android:textColor="#90CAF9"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/anta_font"
                                android:text="Puntualidad a tiempo"
                                android:textColor="#B0BEC5"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvValorIntervaloPromedio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/anta_font"
                                android:text="248.0 h"
                                android:textColor="#80CBC4"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/anta_font"
                                android:text="Intervalo promedio"
                                android:textColor="#B0BEC5"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDiagnosticoDisciplina"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/anta_font"
                        android:text="Excelente disciplina de mantenimiento. La máquina se atiende oportunamente."
                        android:textColor="#CFD8DC"
                        android:textSize="12sp" />

                    <!-- Gráfico Visual de Barras de Intervalos -->
                    <LinearLayout
                        android:id="@+id/layoutBarrasGrafico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ========================================================= -->
            <!-- 3. FILTROS RÁPIDOS POR ESTADO                            -->
            <!-- ========================================================= -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipFiltroTodas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_anio_selected"
                        android:fontFamily="@font/anta_font"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:text="Todas"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipFiltroVencidas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_anio_unselected"
                        android:fontFamily="@font/anta_font"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:text="Vencidas"
                        android:textColor="#B0BEC5"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipFiltroProximas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_anio_unselected"
                        android:fontFamily="@font/anta_font"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:text="Próximas"
                        android:textColor="#B0BEC5"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipFiltroAlDia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_anio_unselected"
                        android:fontFamily="@font/anta_font"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="7dp"
                        android:text="Al día"
                        android:textColor="#B0BEC5"
                        android:textSize="12sp" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- ========================================================= -->
            <!-- 4. CONTENEDOR DE TAREAS POR SUBSISTEMA                   -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/layoutSubsistemasTareas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ========================================================= -->
            <!-- 5. BOTÓN DE ACCIÓN RÁPIDA                                 -->
            <!-- ========================================================= -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNuevoMantenimientoDesdeSalud"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/selection_indicator"
                android:fontFamily="@font/anta_font"
                android:text="Registrar Nuevo Mantenimiento"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/icon_nuevo_blanco"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
