<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardItemSeleccionable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    android:theme="@style/Theme.TextMain"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivIconoItemSeleccionable"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/icon_mantenimiento_blanco"/>

        <TextView
            android:id="@+id/tvNombreItemSeleccionable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Filtro de aceite"
            android:textColor="@color/white"
            android:textSize="16sp"  />

        <CheckBox
            android:id="@+id/checkboxAccesorio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:drawableTint="@color/white"
            android:buttonTint="@color/white"
            android:button="@drawable/checkbox_custom"/>
    </LinearLayout>

</androidx.cardview.widget.CardView>