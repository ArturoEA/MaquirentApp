<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.TextMain">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- FOTO DE PERFIL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="175dp"
                    android:layout_height="150dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgFotoPerfil"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        app:shapeAppearanceOverlay="@style/CircularImageView"
                        android:contentDescription="Foto de perfil"
                        android:scaleType="centerCrop"
                        android:src="@drawable/icon_perfil_blanco"
                        android:backgroundTint="@color/black" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fabCambiarFoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:cropToPadding="false"
                        app:fabSize="mini"
                        android:elevation="0dp"
                        app:backgroundTint="@color/selection_indicator"
                        app:maxImageSize="25dp"
                        app:srcCompat="@drawable/icon_editar_blanco"
                        app:tint="@null" />

                </FrameLayout>
            </LinearLayout>

            <!-- CAMPOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/CustomTextInputLayout"
                    android:layout_marginBottom="0dp"
                    android:hint="Nombre completo"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputNombrePerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:textColor="@color/black" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/CustomTextInputLayout"
                    android:layout_marginBottom="0dp"
                    android:hint="Correo electrónico"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tvEmailPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:clickable="false"
                        android:enabled="false"
                        android:textColor="@color/text_secondary" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Firma digital (Para informes PDF)"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                app:cardBackgroundColor="@color/background_light"
                android:layout_marginBottom="24dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imgFirmaPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="16dp"
                        android:src="@drawable/icon_imagenes_blanco"
                        app:tint="@color/gray_light" />

                    <TextView
                        android:id="@+id/tvPlaceholderFirma"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Toca el botón para subir tu firma\n(Fondo blanco o transparente)"
                        android:textAlignment="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fabSubirFirma"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        app:fabSize="mini"
                        app:elevation="2dp"
                        app:backgroundTint="@color/black"
                        app:tint="@color/white"
                        app:srcCompat="@drawable/icon_editar_blanco" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/item_configuracion"
                android:id="@+id/cambiar_contraseña"
                android:tag="Cambiar contraseña"
                />

            <include layout="@layout/item_configuracion"
                android:id="@+id/btnSignOut"
                android:tag="Cerrar sesión"
                />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
