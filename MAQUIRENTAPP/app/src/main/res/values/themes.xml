<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->

    <style name="Base.Theme.MAQUIRENTAPP" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="materialAlertDialogTheme">@style/DialogoConFuenteAnta</item>
        <item name="colorPrimaryDark">@color/gris_200</item>
        <item name="colorAccent">@color/gris_200</item>
    </style>

    <style name="DialogoConFuenteAnta" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="materialAlertDialogTitleTextStyle">@style/MiTextoTituloDialogo</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MiTextoCuerpoDialogo</item>
        <item name="buttonBarPositiveButtonStyle">@style/MiBotonDialogo</item>
        <item name="buttonBarNegativeButtonStyle">@style/MiBotonDialogo</item>
        <item name="buttonBarNeutralButtonStyle">@style/MiBotonDialogo</item>

        <item name="android:fontFamily">@font/anta_font</item>
        <item name="fontFamily">@font/anta_font</item>

        <item name="colorSurface">@color/black</item>
    </style>

    <style name="MiTextoTituloDialogo" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/anta_font</item>
        <item name="fontFamily">@font/anta_font</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="MiTextoCuerpoDialogo" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/anta_font</item>
        <item name="fontFamily">@font/anta_font</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="MiBotonDialogo" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/anta_font</item>
        <item name="fontFamily">@font/anta_font</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ShapeAppearance.MisDialogos.Redondeado" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="EstiloTextoTitulo" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:shadowColor">@color/azul_200</item>
        <item name="android:shadowDx">5</item>
        <item name="android:shadowDy">5</item>
        <item name="android:shadowRadius">5</item>
    </style>

    <style name="Theme.TextMain" parent="Base.Theme.MAQUIRENTAPP">
        <item name="android:fontFamily">@font/anta_font</item>
    </style>

    <style name="SpinnerTheme" parent="Theme.AppCompat.Light">
        <item name="android:textColor">#000000</item>
        <item name="android:fontFamily">@font/anta_font</item>
    </style>

    <style name="CircularImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="DialogFadeAnimation">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

    <style name="PdfCell">
        <item name="android:background">@drawable/bg_table_border</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">10sp</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="PdfCellBold" parent="PdfCell">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PdfCellCenter" parent="PdfCell">
        <item name="android:gravity">center</item>
        <item name="android:width">60dp</item>
    </style>

    <style name="PdfHeaderCell" parent="PdfCellBold">
        <item name="android:background">@color/selection_indicator</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Theme.Maquirent.UCrop" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/selection_indicator</item>

        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowFullscreen">false</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>

        <item name="android:windowLightStatusBar">false</item>

        <item name="android:fitsSystemWindows">true</item>

        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>
</resources>